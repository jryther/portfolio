{
  "name": "portfolio-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/jryther/portfolio-v3",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "npm run lint && npm run type-check && npm run test:run && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.node.json",
    "embed:topics": "node scripts/embed-topics.mjs"
  },
  "dependencies": {
    "@wllama/wllama": "3.8.1",
    "aos": "2.3.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "25.6.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.5.1",
    "@vue/typescript-plugin": "3.3.13",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
