{
  "name": "portfolio-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/jryther/portfolio-v3",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "npm run lint && npm run test:run && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "embed:topics": "node scripts/embed-topics.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@wllama/wllama": "3.8.1",
    "aos": "^2.3.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.28",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aos": "^3.0.7",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/typescript-plugin": "^3.2.7",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
