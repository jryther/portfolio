# Supply-chain hardening. Applies locally, in CI, and in the Cloudflare build.

# Never run install scripts from packages: the most common way a compromised package runs code
# on install. Nothing here needs them (esbuild ships its binary as a platform package, and
# fsevents is macOS-only); install, tests, and build all pass without them.
ignore-scripts=true

# Only install from the public npm registry
registry=https://registry.npmjs.org/

# New dependencies are saved at an exact version; upgrades come through Dependabot PRs
save-exact=true

# Refuse to install with a Node version this project (or a dependency) doesn't support
engine-strict=true

# `npm audit` fails at moderate severity or above (CI uses this as a check)
audit-level=moderate

# Quieter installs
fund=false
